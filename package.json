{
  "name": "dsh-desktop-auto-restart",
  "version": "0.1.0",
  "description": "DSH 桌面端（Windows）重启插件：从侧边栏按钮或默认关闭的模型工具重启宿主，重启后按会话原有预设自动唤醒；宿主繁忙时拒绝重启。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "重启插件",
    "summary": "把「重启 DSH 宿主」做成 agent 可调的工具和侧边栏按钮，重启后按会话原有预设自动唤醒它。",
    "categories": [
      "运维",
      "宿主"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "tool:dsh_restart"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "node": ">=22"
    }
  },
  "author": "comer2031",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comer2031/dsh-desktop-auto-restart.git"
  },
  "homepage": "https://github.com/comer2031/dsh-desktop-auto-restart#readme",
  "bugs": {
    "url": "https://github.com/comer2031/dsh-desktop-auto-restart/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "reload"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
